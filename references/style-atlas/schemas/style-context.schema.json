{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomfile.dev/style-atlas/schemas/style-context.schema.json",
  "title": "Roomfile style context",
  "type": "object",
  "required": ["schema_version", "pack_refs", "adopted_signals", "rejected_signals", "uncertain_signals", "user_overrides", "contradictions", "live_research_sources", "reference_images"],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "pack_refs": { "type": "array", "items": { "type": "object", "required": ["id", "version", "read_at"], "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "read_at": { "type": "string", "format": "date-time" } }, "additionalProperties": false } },
    "adopted_signals": { "type": "array" },
    "rejected_signals": { "type": "array" },
    "uncertain_signals": { "type": "array" },
    "user_overrides": { "type": "array" },
    "contradictions": { "type": "array" },
    "live_research_sources": { "type": "array" },
    "reference_images": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["pack_id", "visual_id", "path", "reason"], "properties": { "pack_id": { "type": "string" }, "visual_id": { "type": "string" }, "path": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
