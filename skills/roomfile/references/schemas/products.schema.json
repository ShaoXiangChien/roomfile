{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomfile.dev/schemas/products.schema.json",
  "title": "Roomfile products",
  "type": "object",
  "required": ["schema_version", "products"],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "status", "dimensions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["candidate", "shortlisted", "approved", "rejected", "purchased"]
          },
          "retailer": { "type": "string" },
          "product_identifier": { "type": "string" },
          "retailer_product_id": { "type": "string" },
          "article_number": { "type": "string" },
          "asin": { "type": "string" },
          "seller": { "type": "string" },
          "manufacturer": { "type": "string" },
          "dimensions": { "$ref": "#/$defs/dimensions" },
          "package_dimensions": { "$ref": "#/$defs/dimensions" },
          "price": {
            "type": "object",
            "required": ["amount", "currency"],
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
          },
          "availability": { "type": "string" },
          "delivery": {
            "type": "object",
            "properties": {
              "postal_code": { "type": "string" },
              "status": { "enum": ["available", "unavailable", "unknown"] },
              "result": { "type": "string" }
            }
          },
          "source": {
            "type": "object",
            "required": ["url", "retrieved_at"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "retrieved_at": { "type": "string", "format": "date-time" },
              "dimension_source": { "type": "string" }
            }
          },
          "placement": {
            "type": "object",
            "required": ["x", "y", "rotation"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "rotation": { "type": "number" }
            }
          },
          "assembly": { "type": "string" },
          "assembly_required": { "type": "boolean" },
          "return_notes": { "type": "string" },
          "locked": { "type": "boolean" },
          "approval": {
            "type": "object",
            "required": ["approved_by_user", "approved_at"],
            "properties": {
              "approved_by_user": { "const": true },
              "approved_at": { "type": "string", "format": "date-time" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": { "enum": ["approved", "purchased"] }
              }
            },
            "then": {
              "required": ["approval"]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["width", "depth", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["in", "cm"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
