{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomfile.dev/schemas/facts.schema.json",
  "title": "Roomfile facts",
  "type": "object",
  "required": ["schema_version", "facts"],
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "classification", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["observed", "measured", "inferred", "desired"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "minLength": 1 },
          "critical_for_fit": { "type": "boolean", "default": false },
          "value": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
